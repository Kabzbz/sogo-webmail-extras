# Файлы уезжают на Linux-сервер: переводы строк только LF.
# Иначе shell-строка скрипта приезжает как "#!/usr/bin/env python3\r"
# и запуск падает с "env: python3\r: No such file or directory".
* text=auto eol=lf
*.py text eol=lf
*.js text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.md text eol=lf
